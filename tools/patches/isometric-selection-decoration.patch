+using NUnit.Framework;
+using OpenRA.Mods.Common.Traits;
+
+namespace OpenRA.Test
+{
+	[TestFixture]
+	public class SupportPowerLevelTest
+	{
+		[TestCase(false)]
+		[TestCase(true)]
+		public void EmptyLevelsRemainUnavailable(bool allTech)
+		{
+			var info = new AirstrikePowerInfo();
+			Assert.That(info.GetAvailableLevel(allTech, _ => true), Is.Zero);
+		}
+
+		[Test]
+		public void NormalModeUsesHighestSatisfiedLevel()
+		{
+			var info = new AirstrikePowerInfo();
+			info.Prerequisites.Add(1, new[] { "tier1" });
+			info.Prerequisites.Add(3, new[] { "tier3" });
+			Assert.That(info.GetAvailableLevel(false, p => p[0] == "tier1"), Is.EqualTo(1));
+			Assert.That(info.GetAvailableLevel(false, _ => false), Is.Zero);
+			Assert.That(info.GetAvailableLevel(false, _ => true), Is.EqualTo(3));
+		}
+
+		[Test]
+		public void AllTechUsesHighestDefinedLevelWithoutQueryingTechTree()
+		{
+			var info = new AirstrikePowerInfo();
+			info.Prerequisites.Add(1, new[] { "tier1" });
+			info.Prerequisites.Add(3, new[] { "tier3" });
+			Assert.That(info.GetAvailableLevel(true, _ => throw new System.InvalidOperationException()), Is.EqualTo(3));
+		}
+	}
