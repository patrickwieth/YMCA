+using NUnit.Framework;
+using OpenRA.Mods.Common.Traits;
+
+namespace OpenRA.Test
+{
+	[TestFixture]
+	public class IsometricSelectionDecorationTest
+	{
+		[Test]
+		public void DecorationFootprintIsOptIn()
+		{
+			var info = new IsometricSelectableInfo();
+			Assert.That(info.DecorationFootprint, Is.EqualTo(CVec.Zero));
+			Assert.That(info.DecorationFootprintExtraDepth, Is.Zero);
+		}
+
+		[Test]
+		public void EnlargedDecorationDoesNotChangeInteractionSettings()
+		{
+			var info = new IsometricSelectableInfo();
+			var originalHeight = info.Height;
+			FieldLoader.Load(info, new MiniYaml("", MiniYaml.FromString(
+				"DecorationFootprint: 4,2\nDecorationFootprintExtraDepth: 181\nDecorationHeight: 83", "selection-test")));
+			Assert.That(info.DecorationFootprint, Is.EqualTo(new CVec(4, 2)));
+			Assert.That(info.DecorationFootprintExtraDepth, Is.EqualTo(181));
+			Assert.That(info.DecorationHeight, Is.EqualTo(83));
+			Assert.That(info.Bounds, Is.Null);
+			Assert.That(info.Height, Is.EqualTo(originalHeight));
+		}
+	}
+}
