+using System;
+using System.IO;
+using System.Reflection;
+using NUnit.Framework;
+using OpenRA.Network;
+
+namespace OpenRA.Test
+{
+	[TestFixture]
+	[NonParallelizable]
+	public class LaunchUriSessionResetTest
+	{
+		[Test]
+		public void ForwardedLinkClearsOldPlayableSlotsBeforeShellmapLoads()
+		{
+			const BindingFlags Flags = BindingFlags.Static | BindingFlags.NonPublic;
+			var managerField = typeof(Game).GetField("OrderManager", Flags);
+			var previousManager = managerField.GetValue(null);
+			var previousSettings = Game.Settings;
+			var old = new OrderManager(new EchoConnection());
+			try
+			{
+				Game.Settings = new Settings(Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".yaml"), new Arguments(Array.Empty<string>()));
+				old.LobbyInfo.Slots.Add("Multi1", new Session.Slot { PlayerReference = "Multi1" });
+				old.LobbyInfo.Clients.Add(new Session.Client { Index = 0, Slot = "Multi1", Faction = "russia" });
+				managerField.SetValue(null, old);
+
+				typeof(Game).GetMethod("ResetSessionForLaunchUri", Flags).Invoke(null, null);
+
+				var current = (OrderManager)managerField.GetValue(null);
+				Assert.That(current, Is.Not.SameAs(old));
+				Assert.That(current.LobbyInfo.Slots, Is.Empty);
+				Assert.That(current.LobbyInfo.Clients.Count, Is.EqualTo(1));
+				Assert.That(current.LobbyInfo.Clients[0].Slot, Is.Null);
+				Assert.That(current.Connection, Is.TypeOf<EchoConnection>());
+			}
+			finally
+			{
+				((OrderManager)managerField.GetValue(null))?.Dispose();
+				old.Dispose();
+				managerField.SetValue(null, previousManager);
+				Game.Settings = previousSettings;
+			}
+		}
+	}
+}
