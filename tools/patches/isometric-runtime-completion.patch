+				AddTemplateId(t.SE);
+				AddTemplateId(t.SW);
+				AddTemplateId(t.WNE);
+				AddTemplateId(t.NES);
+				AddTemplateId(t.SWN);
+				AddTemplateId(t.ESW);
+				AddTemplateId(t.NESW);
