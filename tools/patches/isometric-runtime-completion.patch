+				return offsets;
+			}
+
+			var uv = cell.ToMPos(map.Grid.Type);
+			for (var dv = -AutoTileUpdateRadius; dv <= AutoTileUpdateRadius; dv++)
+			{
+				for (var du = -AutoTileUpdateRadius; du <= AutoTileUpdateRadius; du++)
+				{
+					var n = new MPos(uv.U + du, uv.V + dv).ToCPos(map.Grid.Type);
+					offsets.Add(n - cell);
