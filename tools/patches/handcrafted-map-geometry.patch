+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using OpenRA.Primitives;
+
+namespace OpenRA
+{
+	public sealed partial class Map
+	{
+		/// <summary>Optional flat logical-cell rectangle inside the projected bounds; empty retains normal map behavior.</summary>
+		public Rectangle CellBounds;
+
+		/// <summary>Persistent gameplay terrain independent of visual tiles; resource/bridge overrides still take precedence.</summary>
+		public MiniYaml BaseTerrainOverrides;
+
+		readonly Dictionary<CPos, byte> baseTerrainOverrides = new();
+
+		void InitializeBaseTerrainOverrides()
+		{
+			baseTerrainOverrides.Clear();
+			if (BaseTerrainOverrides == null)
+				return;
+
+			foreach (var node in BaseTerrainOverrides.Nodes)
+			{
+				var cell = FieldLoader.GetValue<CPos>("BaseTerrainOverrides", node.Key);
+				var uv = cell.ToMPos(Grid.Type);
+				if (!Tiles.Contains(uv) || !baseTerrainOverrides.TryAdd(cell, Rules.TerrainInfo.GetTerrainIndex(node.Value.Value)))
+					throw new InvalidDataException("Duplicate or out-of-storage base terrain override: " + cell);
+			}
+		}
+
+		/// <summary>Whether this flat map uses an explicit logical-cell playable rectangle.</summary>
+		public bool HasCellBounds => CellBounds.Width > 0 && CellBounds.Height > 0;
+
+		bool CellBoundsContains(MPos uv)
+		{
+			var cell = uv.ToCPos(Grid.Type);
+			return CellBounds.Contains(cell.X, cell.Y);
+		}
+
+		void ValidateCellBounds()
+		{
+			if (CellBounds.Width == 0 && CellBounds.Height == 0)
+				return;
+
+			if (!HasCellBounds || Grid.Type != MapGridType.RectangularIsometric)
+				throw new InvalidDataException("CellBounds requires a positive flat isometric logical rectangle.");
+
+			foreach (var cell in AllCells)
+				if (Height[cell] != 0)
+					throw new InvalidDataException("CellBounds does not support raised terrain.");
+
+			foreach (var cell in CellBoundsEdges())
+			{
+				var uv = cell.ToMPos(Grid.Type);
+				if (cell.X < cell.Y || !Tiles.Contains(uv) || !Bounds.Contains(uv.U, uv.V))
+					throw new InvalidDataException("CellBounds exceeds map storage or projected bounds.");
+			}
+		}
+
+		CPos ClampToCellBounds(CPos cell) => new(
+			cell.X.Clamp(CellBounds.Left, CellBounds.Right - 1),
+			cell.Y.Clamp(CellBounds.Top, CellBounds.Bottom - 1));
+
+		CPos ClosestCellBoundsEdge(CPos cell)
+		{
+			var p = ClampToCellBounds(cell);
+			return new[] { new CPos(CellBounds.Left, p.Y), new CPos(CellBounds.Right - 1, p.Y),
+				new CPos(p.X, CellBounds.Top), new CPos(p.X, CellBounds.Bottom - 1) }
+				.OrderBy(c => (c - cell).LengthSquared).First();
+		}
+
+		List<CPos> CellBoundsEdges()
+		{
+			var result = new HashSet<CPos>();
+			for (var x = CellBounds.Left; x < CellBounds.Right; x++)
+			{
+				result.Add(new CPos(x, CellBounds.Top));
+				result.Add(new CPos(x, CellBounds.Bottom - 1));
+			}
+
+			for (var y = CellBounds.Top; y < CellBounds.Bottom; y++)
+			{
+				result.Add(new CPos(CellBounds.Left, y));
+				result.Add(new CPos(CellBounds.Right - 1, y));
+			}
+
+			return result.OrderBy(c => c.Y).ThenBy(c => c.X).ToList();
+		}
+
+		WDist DistanceToCellBoundsEdge(WPos pos, in WVec dir)
+		{
+			if (dir.Length == 0)
+				return WDist.Zero;
+
+			var projected = pos - new WVec(0, pos.Z, pos.Z);
+			var x = (projected.X + (double)projected.Y) / 1448 - 1;
+			var y = (projected.Y - (double)projected.X) / 1448;
+			var dx = (dir.X + (double)dir.Y) / 1448;
+			var dy = (dir.Y - (double)dir.X) / 1448;
+			var tx = dx == 0 ? double.PositiveInfinity : ((dx < 0 ? CellBounds.Left - .5 : CellBounds.Right - .5) - x) / dx;
+			var ty = dy == 0 ? double.PositiveInfinity : ((dy < 0 ? CellBounds.Top - .5 : CellBounds.Bottom - .5) - y) / dy;
+			return new WDist((int)Math.Max(0, Math.Min(int.MaxValue, Math.Min(tx, ty) * dir.Length)));
+		}
+	}
+}
