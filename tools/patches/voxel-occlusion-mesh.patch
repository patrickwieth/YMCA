+		/// <summary>Visible model meshes with the same screen transform as the voxel renderer, excluding shadows.</summary>
+		public IEnumerable<(ModelRenderData Data, float[] Transform)> OcclusionMeshes(WorldRenderer wr)
+		{
+			var cameraTransform = Util.MakeFloatMatrix(camera.AsMatrix());
+			var scaleTransform = Util.ScaleMatrix(scale, scale, scale);
+			foreach (var animation in models.Where(m => m.IsVisible))
+			{
+				var rotation = Util.MakeFloatMatrix(animation.RotationFunc().AsMatrix());
+				var transform = Util.MatrixMultiply(cameraTransform, Util.MatrixMultiply(scaleTransform, rotation));
+				var offset = wr.ScreenVectorComponents(animation.OffsetFunc());
+				transform = Util.MatrixMultiply(Util.TranslationMatrix(offset.X, offset.Y, offset.Z), transform);
+				for (uint section = 0; section < animation.Model.Sections; section++)
+					yield return (animation.Model.RenderData(section), Util.MatrixMultiply(transform,
+						animation.Model.TransformationMatrix(section, animation.FrameFunc())));
+			}
+		}
