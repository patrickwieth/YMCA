+using System.Collections.Generic;
+using OpenRA.Activities;
+using OpenRA.GameRules;
+using OpenRA.Traits;
+
+namespace OpenRA.Mods.Common.Traits
+{
+	// Optional mod policy. Mods without this world trait retain existing behavior.
+	public interface ITerrainFireControl
+	{
+		bool Handles(WeaponInfo weapon);
+		bool TryBlock(WeaponInfo weapon, WPos from, WPos to, out WPos hit);
+		bool CanFire(Actor self, Armament armament, Target target, WPos position);
+		Activity FindFiringPosition(Actor self, IEnumerable<Armament> armaments, Target target);
+	}
+
+	public static class TerrainFireControl
+	{
+		public static bool TryBlock(World world, WeaponInfo weapon, WPos from, WPos to, out WPos hit)
+		{
+			hit = to;
+			return world.WorldActor.TraitOrDefault<ITerrainFireControl>()?.TryBlock(weapon, from, to, out hit) == true;
+		}
+		public static bool ActiveFor(World world, WeaponInfo weapon) => world.WorldActor.TraitOrDefault<ITerrainFireControl>()?.Handles(weapon) == true;
+		public static bool BelowTerrain(World world, WeaponInfo weapon, WPos position)
+		{
+			var policy = world.WorldActor.TraitOrDefault<ITerrainFireControl>();
+			return policy != null && policy.Handles(weapon) ? policy.TryBlock(weapon, position, position, out _) : world.Map.DistanceAboveTerrain(position).Length < 0;
+		}
+		public static bool CanFire(Actor self, Armament armament, Target target, WPos position) =>
+			self.World.WorldActor.TraitOrDefault<ITerrainFireControl>()?.CanFire(self, armament, target, position) ?? true;
+		public static Activity FindFiringPosition(Actor self, IEnumerable<Armament> armaments, Target target) =>
+			self.World.WorldActor.TraitOrDefault<ITerrainFireControl>()?.FindFiringPosition(self, armaments, target);
+	}
+}
