@@ -0,0 +1,35 @@
+using System;
+using System.Linq;
+
+namespace OpenRA.FileFormats
+{
+	// Implemented by mods that support portable replay maps and legacy recipes.
+	public interface IReplayMapProvider
+	{
+		byte[] Capture(ModData mod, string mapUid);
+		bool Restore(ModData mod, ReplayMetadata replay);
+	}
+
+	public static class ReplayMapSupport
+	{
+		static IReplayMapProvider Provider(ModData mod)
+		{
+			var type = mod.ObjectCreator.GetTypesImplementing<IReplayMapProvider>().FirstOrDefault(t => !t.IsAbstract && !t.IsInterface);
+			return type == null ? null : (IReplayMapProvider)Activator.CreateInstance(type);
+		}
+
+		public static byte[] Capture(ModData mod, string mapUid)
+		{
+			try { return Provider(mod)?.Capture(mod, mapUid); }
+			catch (Exception e) { Log.Write("debug", "Could not embed replay map: " + e); return null; }
+		}
+
+		public static bool Restore(ModData mod, ReplayMetadata replay)
+		{
+			if (replay == null) return false;
+			if (mod.MapCache[replay.GameInfo.MapUid].Status == MapStatus.Available) return true;
+			try { return Provider(mod)?.Restore(mod, replay) ?? false; }
+			catch (Exception e) { Log.Write("debug", "Could not restore replay map: " + e); return false; }
+		}
+	}
+}
